# =============================================================================
# .env.example — copy to `.env` and fill in what you need:
#     cp .env.example .env            (macOS/Linux)
#     copy .env.example .env          (Windows)
# `.env` is git-ignored. NEVER commit real keys.
# Blank values fall back to defaults; provider/model have no default on purpose.
# =============================================================================

# ---------- Chat model ----------
# Provider: openai | anthropic | google_genai | ollama
LLM_PROVIDER=
# Model name from your provider's docs
LLM_MODEL=
LLM_TEMPERATURE=0.2

# ---------- Embeddings (for RAG) ----------
# Provider: openai | google_genai | ollama   (Anthropic has no embeddings API)
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

# ---------- Provider credentials (only the ones you use) ----------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ---------- Observability (LangSmith) ----------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-framework

# ---------- Paths & runtime ----------
# Relative paths are resolved from the ai-framework folder
DATA_DIR=data
VECTORSTORE_DIR=vectorstore
# Max simultaneous LLM calls in async/batch workflows
MAX_CONCURRENCY=5
